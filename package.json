{
  "name": "app-cong-no",
  "version": "0.1.7",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "description": "Ứng dụng quản lý công nợ phải thu của khách hàng từ dữ liệu MISA",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "pnpm build:domain && vite",
    "lan": "pnpm build:domain && node server/start.cjs",
    "lan:init-admin": "pnpm build:domain && node server/start.cjs --init-admin",
    "build": "pnpm build:domain && tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "biome lint src tests vite.config.ts vitest.config.ts --error-on-warnings",
    "check:electron": "node --check electron/main.cjs && node --check electron/lan-host.cjs && node --check server/database.cjs && node --check server/books.cjs && node --check server/development.cjs",
    "test": "pnpm build:domain && vitest run",
    "test:sqlite": "node --test tests/sqlite-database.test.cjs",
    "test:lan": "pnpm build:domain && node --test tests/lan.test.cjs tests/lan-security.test.cjs tests/customer-scope.test.cjs tests/receipt-advance.test.cjs tests/receipt-duplicate.test.cjs tests/operations.test.cjs",
    "test:watch": "pnpm build:domain && vitest",
    "test:coverage": "pnpm build:domain && vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm check:electron && pnpm test && pnpm test:sqlite && pnpm test:lan",
    "preview": "pnpm build:domain && node server/development.cjs",
    "start": "pnpm build:domain && electron .",
    "desktop": "pnpm build && electron . --local",
    "desktop:lan": "pnpm build:domain && electron . --lan",
    "dist": "pnpm build && node electron/build-windows.mjs",
    "dev:init-admin": "pnpm build:domain && node server/init-dev-admin.cjs",
    "test:desktop": "pnpm build:domain && node tests/electron-http-smoke.cjs && node tests/electron-first-admin-smoke.cjs && node tests/electron-workstation-smoke.cjs",
    "test:release": "node --test tests/release-artifacts.test.cjs",
    "build:domain": "node server/build-domain.mjs",
    "test:golden": "pnpm build:domain && vitest run tests/golden-numbers.test.ts",
    "test:performance": "pnpm build:domain && node tests/performance/accounting.benchmark.cjs"
  },
  "build": {
    "appId": "vn.naviva.congno",
    "productName": "Quản lý công nợ",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/assets/app-icon.png",
      "src/domain/settings/business-data.rules.mjs",
      "src/domain/access/permissions.mjs",
      "src/domain/customers/vietnamese-text.mjs",
      "package.json"
    ],
    "win": {
      "icon": "public/assets/app-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Quan-Ly-Cong-No-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quản lý công nợ",
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bosunrang",
        "repo": "quan-ly-cong-no",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
